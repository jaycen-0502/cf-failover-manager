[Unit]
Description=Cloudflare Failover Telegram Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/opt/cf-failover/.venv/bin/python -u /opt/cf-failover/tg_bot.py
Restart=always
RestartSec=5
User=root
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
